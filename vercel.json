{
  "rewrites": [
    {
      "source": "/badge/:slug/:metric.svg",
      "destination": "/api/share?kind=badge&slug=:slug&metric=:metric"
    },
    {
      "source": "/badge/:slug.svg",
      "destination": "/api/share?kind=badge&slug=:slug"
    },
    {
      "source": "/og/:slug.png",
      "destination": "/api/share?kind=og&slug=:slug"
    },
    {
      "source": "/p/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|Pinterest|redditbot|Embedly|Mastodon|SkypeUriPreview|Applebot|Iframely|[Gg]ooglebot|bingbot).*"
        }
      ],
      "destination": "/api/share?kind=page&slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/share.ts": {
      "includeFiles": "api/_fonts/**",
      "maxDuration": 15
    }
  }
}
